# Copy this file to .env and change the values for your machine.
# Do not commit .env because every developer can have a different database URL.

# Local PostgreSQL examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/clothcycle
# DATABASE_URL=postgresql://postgres:password@localhost:6543/clothcycle

# Shared hosted PostgreSQL example:
# DATABASE_URL=postgresql://username:password@host:5432/clothcycle?sslmode=require

DATABASE_URL=postgresql://postgres:password@localhost:5432/clothcycle
JWT_SECRET=change_this_to_the_same_shared_dev_secret
TWO_FACTOR_ENCRYPTION_KEY=change_this_to_a_long_random_secret_for_totp_encryption
CORS_ORIGIN=https://clothcycleph.com,https://www.clothcycleph.com,http://localhost:5173
APP_URL=http://localhost:5173
R2_PUBLIC_BASE_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379

# Email sending. Use "brevo", "resend", or "sendgrid" for real email,
# and "console" for local-only logs. The selected provider needs its matching
# API key. EMAIL_FROM must be a verified sender for that provider.
EMAIL_PROVIDER=console
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=ClothCycle PH <onboarding@resend.dev>

# Google Identity Services web client ID.
# Must match frontend VITE_GOOGLE_CLIENT_ID.
# Configure Authorized JavaScript origins in Google Cloud Console:
# - http://localhost:5173
# - http://127.0.0.1:5173
# - production frontend origin
# Google Identity Services One Tap/Button returns an ID token directly to the
# browser callback, so no redirect URI or client secret is required for this flow.
GOOGLE_CLIENT_ID=

# Cloudflare R2 public delivery. For Worker local testing, the Worker can serve
# uploaded objects through /api/uploads/:key when R2 is bound.
R2_PUBLIC_BASE_URL=http://localhost:8787
