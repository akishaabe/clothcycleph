FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && update-ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm install

RUN groupadd --system wrangler \
  && useradd --system --create-home --gid wrangler wrangler \
  && mkdir -p /home/wrangler/.config/.wrangler /home/wrangler/.cache /home/wrangler/.npm \
  && chown -R wrangler:wrangler /app /home/wrangler

USER wrangler

ENV HOME="/home/wrangler" \
  NPM_CONFIG_CACHE="/home/wrangler/.npm" \
  PATH="/app/node_modules/.bin:${PATH}"

CMD ["wrangler", "--version"]
