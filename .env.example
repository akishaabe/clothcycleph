VITE_API_URL=http://localhost:5000/api
# Production example:
# VITE_API_URL=https://api.clothcycleph.com/api

# Display timezone for user-facing dates. Defaults to Asia/Manila when omitted.
VITE_DISPLAY_TIME_ZONE=Asia/Manila

# Google Identity Services web client ID.
# The same client ID must be configured as GOOGLE_CLIENT_ID in backend/.env.
# Add http://localhost:5173, http://127.0.0.1:5173, and production frontend URLs
# as Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
